---
export interface Props {
  place?: 'top' | 'bottom'
}

const { place = 'top' } = Astro.props
---

<div
  class="pointer-events-none absolute hidden md:block w-[300px] h-[300px]"
  class:list={{ '-mt-40 right-0 rotate-180': place === 'bottom' }}
>
  <div class="absolute flex w-full">
    <div class="w-full h-5 overflow-hidden bg-linear-to-r gradient to-green-500 flex justify-end rounded-l-3xl">
      <div class="rotate-45 w-5 h-12 bg-zinc-900"></div>
    </div>
  </div>
  <div class="absolute flex flex-col h-full">
    <div class="h-full w-5 overflow-hidden bg-linear-to-b gradient flex items-end rounded-t-3xl">
      <div class="rotate-45 -mb-5 w-5 h-12 bg-zinc-900"></div>
    </div>
  </div>
</div>
