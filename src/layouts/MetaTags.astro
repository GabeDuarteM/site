---
export interface Props {
  title: string
}

const { title } = Astro.props

const description =
  'Software developer, nerd, gamer. Gabriel is a curious developer from Brazil, currently living in Germany. He loves helping organizations to build ambitious and well structured web projects. Sometimes, he also writes in the third person.'
---

<meta charset="UTF-8" />
<meta content="width=device-width" name="viewport" />
<link href="/favicon.ico" rel="icon" type="image/x-icon" />

<meta content={description} name="description" />
<meta content="https://gabrielduarte.dev/twitter.png" name="twitter:image" />
<meta content="summary_large_image" name="twitter:card" />
<meta content="@GabeDuarteM" name="twitter:creator" />
<meta content="Gabriel Duarte" property="og:title" />
<meta content={description} property="og:description" />
<meta content="https://gabrielduarte.dev/twitter.png" name="og:image" />
<meta content="#1b0843" name="theme-color" />

<title>{title}</title>

<link href="https://fonts.googleapis.com" rel="preconnect" />
<link crossorigin="anonymous" href="https://fonts.gstatic.com" rel="preconnect" />
<link
  as="style"
  href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500&display=swap"
  onload="this.onload=null;this.rel='stylesheet'"
  rel="preload"
/>
<link
  as="style"
  href="https://fonts.googleapis.com/css2?family=Roboto&display=swap"
  onload="this.onload=null;this.rel='stylesheet'"
  rel="stylesheet"
  rel="preload"
/>
<noscript>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet" />
</noscript>
